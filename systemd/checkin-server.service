[Unit]
Description=Check-in system server
After=network.target

[Service]
Type=simple
# EDIT this path to wherever you copied the checkin-system folder on THIS machine
WorkingDirectory=/home/pi/checkin-system
ExecStart=/usr/bin/node server/server.js
Restart=always
RestartSec=3
User=pi
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target

# --- Install ---
#   sudo cp checkin-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now checkin-server
#
# --- Check on it ---
#   systemctl status checkin-server
#   journalctl -u checkin-server -f
